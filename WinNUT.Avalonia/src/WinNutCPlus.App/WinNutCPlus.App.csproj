<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\WinNut.ico</ApplicationIcon>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>WinNutCPlus.App</RootNamespace>
    <AssemblyName>WinNutCPlus</AssemblyName>
    <Product>WinNutCPlus</Product>
    <AssemblyTitle>WinNutCPlus</AssemblyTitle>
    <Company>RikoDEV</Company>
    <!-- Only applies to self-contained `dotnet publish` (installer builds); a plain build/run
         is unaffected. Cuts unused BCL and Avalonia cross-platform backend (X11/macOS/Vulkan)
         assemblies out of the win-x64 install. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinNutCPlus.Core\WinNutCPlus.Core.csproj" />
  </ItemGroup>

  <!-- Native packages (SkiaSharp, HarfBuzzSharp) copy their .pdb files into the publish output;
       those are debug symbols with no runtime value and shouldn't ship in the installer. -->
  <Target Name="RemovePdbFromPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PdbToRemove Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbToRemove)" />
  </Target>
</Project>
