<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinNutCPlus.App.ViewModels"
        xmlns:local="using:WinNutCPlus.App.Converters"
        xmlns:loc="using:WinNutCPlus.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="320"
        Width="460" Height="320" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBgBrush}"
        Icon="avares://WinNutCPlus/Assets/Icons/WinNut.ico"
        x:Class="WinNutCPlus.App.Views.ShutdownWindow"
        x:DataType="vm:ShutdownViewModel"
        Title="{loc:Loc ShutdownWindowTitle}">

    <Design.DataContext>
        <vm:ShutdownViewModel />
    </Design.DataContext>

    <Border Classes="card" Margin="16" BorderBrush="{DynamicResource StatusBadBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                           Foreground="{DynamicResource StatusBadBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{loc:Loc ShutdownWarningMessage}" TextWrapping="Wrap" Classes="h2" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Classes="subtitle" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Text="{Binding RemainingText}" FontSize="34" FontWeight="Bold"
                       HorizontalAlignment="Center">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{Binding BlinkOn, Converter={x:Static local:BlinkColorConverter.Instance}}" />
                </TextBlock.Foreground>
            </TextBlock>

            <Grid Grid.Row="3">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="10" CornerRadius="5" />
            </Grid>

            <StackPanel Grid.Row="4" Spacing="8">
                <Button Classes="secondary" Content="{loc:Loc ShutdownGraceButton}" Command="{Binding GraceCommand}" IsVisible="{Binding CanUseGrace}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Classes="danger" Content="{loc:Loc ShutdownImmediateButton}" Command="{Binding ShutdownNowCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>

</Window>
