<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinNutCPlus.App.ViewModels"
        xmlns:loc="using:WinNutCPlus.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="580"
        Width="700" Height="580" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Icon="avares://WinNutCPlus/Assets/Icons/WinNut.ico"
        x:Class="WinNutCPlus.App.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="WinNutCPlus Preferences">

    <Design.DataContext>
        <vm:PreferencesViewModel />
    </Design.DataContext>

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="{Binding ValidationError}"
                   Foreground="{DynamicResource StatusBadBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Classes="secondary" Content="{loc:Loc ButtonCancel}" Command="{Binding CancelCommand}" />
            <Button Classes="secondary" Content="{loc:Loc ButtonApplyChanges}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsModified}" />
            <Button Classes="primary" Content="{loc:Loc ButtonOk}" Command="{Binding OkCommand}" />
        </StackPanel>

        <Grid ColumnDefinitions="150,Auto,*">

            <!-- Section nav -->
            <ListBox Grid.Column="0" Classes="nav-list" SelectedIndex="{Binding SelectedSectionIndex}">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE774;" Classes="nav-icon" />
                        <TextBlock Text="{loc:Loc TabConnection}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE9E9;" Classes="nav-icon" />
                        <TextBlock Text="{loc:Loc TabCalibration}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE712;" Classes="nav-icon" />
                        <TextBlock Text="{loc:Loc TabMiscellaneous}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE7E8;" Classes="nav-icon" />
                        <TextBlock Text="{loc:Loc TabShutdown}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE895;" Classes="nav-icon" />
                        <TextBlock Text="{loc:Loc TabUpdate}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <Border Grid.Column="1" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1,0,0,0" Margin="12,0" />

            <!-- Section content -->
            <Grid Grid.Column="2">
                <ScrollViewer Padding="0,0,10,24" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsConnectionSection}">
                    <StackPanel Spacing="14" Margin="0,0,0,28">
                        <TextBlock Text="{loc:Loc TabConnection}" Classes="h2" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldNutHost}" Classes="field-label" />
                            <TextBox Text="{Binding ServerAddress}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldNutPort}" Classes="field-label" />
                            <NumericUpDown Value="{Binding ServerPort}" Minimum="1" Maximum="65535" FormatString="0" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldUpsName}" Classes="field-label" />
                            <TextBox Text="{Binding UpsName}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label">
                                <Run Text="{loc:Loc FieldPollingInterval}" /><Run Text=" (" /><Run Text="{loc:Loc PollingSeconds}" /><Run Text=")" />
                            </TextBlock>
                            <NumericUpDown Value="{Binding PollIntervalSeconds}" Minimum="0.1" Maximum="60" Increment="0.1" FormatString="0.0" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6" />

                        <TextBlock Text="{loc:Loc LoginCredentialsHint}" Classes="subtitle" TextWrapping="Wrap" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldLogin}" Classes="field-label" />
                            <TextBox Text="{Binding Login}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldPassword}" Classes="field-label" />
                            <TextBox Text="{Binding Password}" PasswordChar="*" />
                        </StackPanel>
                        <CheckBox Content="{loc:Loc FieldAutoReconnect}" IsChecked="{Binding AutoReconnect}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Padding="0,0,10,24" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsCalibrationSection}">
                    <StackPanel Spacing="14" Margin="0,0,0,28">
                        <TextBlock Text="{loc:Loc TabCalibration}" Classes="h2" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label">
                                <Run Text="{loc:Loc FieldNominalFrequency}" /><Run Text=" (Hz — 50/60)" />
                            </TextBlock>
                            <NumericUpDown Value="{Binding FreqInNominal}" Minimum="50" Maximum="60" Increment="10" FormatString="0" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label"><Run Text="{loc:Loc FieldInputVoltage}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMin}" /></TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="field-label"><Run Text="{loc:Loc FieldInputVoltage}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMax}" /></TextBlock>
                            <NumericUpDown Grid.Row="1" Grid.Column="0" Value="{Binding VoltInMin}" Minimum="0" Maximum="999" FormatString="0" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding VoltInMax}" Minimum="0" Maximum="999" FormatString="0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label"><Run Text="{loc:Loc FieldInputFrequency}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMin}" /></TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="field-label"><Run Text="{loc:Loc FieldInputFrequency}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMax}" /></TextBlock>
                            <NumericUpDown Grid.Row="3" Grid.Column="0" Value="{Binding FreqInMin}" Minimum="0" Maximum="100" FormatString="0" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding FreqInMax}" Minimum="0" Maximum="100" FormatString="0" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label"><Run Text="{loc:Loc FieldOutputVoltage}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMin}" /></TextBlock>
                            <TextBlock Grid.Row="4" Grid.Column="1" Classes="field-label"><Run Text="{loc:Loc FieldOutputVoltage}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMax}" /></TextBlock>
                            <NumericUpDown Grid.Row="5" Grid.Column="0" Value="{Binding VoltOutMin}" Minimum="0" Maximum="999" FormatString="0" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding VoltOutMax}" Minimum="0" Maximum="999" FormatString="0" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Classes="field-label"><Run Text="{loc:Loc FieldBatteryVoltage}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMin}" /></TextBlock>
                            <TextBlock Grid.Row="6" Grid.Column="1" Classes="field-label"><Run Text="{loc:Loc FieldBatteryVoltage}" /><Run Text=" — " /><Run Text="{loc:Loc LabelMax}" /></TextBlock>
                            <NumericUpDown Grid.Row="7" Grid.Column="0" Value="{Binding BattVMin}" Minimum="0" Maximum="999" FormatString="0" />
                            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding BattVMax}" Minimum="0" Maximum="999" FormatString="0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Padding="0,0,10,24" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsMiscSection}">
                    <StackPanel Spacing="10" Margin="0,0,0,28">
                        <TextBlock Text="{loc:Loc TabMiscellaneous}" Classes="h2" Margin="0,0,0,4" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldLanguage}" Classes="field-label" />
                            <ComboBox ItemsSource="{Binding AvailableLanguageNames}" SelectedIndex="{Binding LanguageIndex}" HorizontalAlignment="Left" Width="200" />
                            <TextBlock Text="{loc:Loc FieldLanguageRestartNote}" Classes="subtitle" FontSize="11" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldTheme}" Classes="field-label" />
                            <ComboBox SelectedIndex="{Binding ThemeMode}" HorizontalAlignment="Left" Width="200">
                                <ComboBoxItem Content="{loc:Loc ThemeSystem}" />
                                <ComboBoxItem Content="{loc:Loc ThemeLight}" />
                                <ComboBoxItem Content="{loc:Loc ThemeDark}" />
                            </ComboBox>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6" />
                        <CheckBox Content="{loc:Loc FieldMinimizeToTray}" IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Content="{loc:Loc FieldStartMinimized}" IsChecked="{Binding MinimizeOnStart}" IsEnabled="{Binding MinimizeToTray}" />
                        <CheckBox Content="{loc:Loc FieldCloseToTray}" IsChecked="{Binding CloseToTray}" IsEnabled="{Binding MinimizeToTray}" />
                        <CheckBox Content="{loc:Loc FieldStartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                        <Border BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,6" />
                        <CheckBox Content="{loc:Loc FieldCreateLogFile}" IsChecked="{Binding LogToFile}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldLogLevel}" Classes="field-label" />
                            <ComboBox SelectedIndex="{Binding LogLevel}" HorizontalAlignment="Left" Width="200">
                                <ComboBoxItem Content="Notice" />
                                <ComboBoxItem Content="Warning" />
                                <ComboBoxItem Content="Error" />
                                <ComboBoxItem Content="Debug" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Padding="0,0,10,24" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsShutdownSection}">
                    <StackPanel Spacing="14" Margin="0,0,0,28">
                        <TextBlock Text="{loc:Loc TabShutdown}" Classes="h2" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="field-label"><Run Text="{loc:Loc FieldBattLimitLoad}" /><Run Text=" (%)" /></TextBlock>
                            <NumericUpDown Value="{Binding BattChargeFloor}" Minimum="0" Maximum="100" FormatString="0" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldBattLimitTime}" Classes="field-label" />
                            <NumericUpDown Value="{Binding RuntimeFloorSec}" Minimum="0" Maximum="3600" FormatString="0" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>
                        <CheckBox Content="{loc:Loc FieldImmediateStop}" IsChecked="{Binding ImmediateStop}" />
                        <CheckBox Content="{loc:Loc FieldRespectFsd}" IsChecked="{Binding RespectFsd}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldStopType}" Classes="field-label" />
                            <ComboBox SelectedIndex="{Binding StopType}" HorizontalAlignment="Left" Width="200">
                                <ComboBoxItem Content="Shut down" />
                                <ComboBoxItem Content="Suspend" />
                                <ComboBoxItem Content="Hibernate" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldDelayToShutdown}" Classes="field-label" />
                            <NumericUpDown Value="{Binding StopDelaySec}" Minimum="1" Maximum="3600" FormatString="0" IsEnabled="{Binding !ImmediateStop}" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>
                        <CheckBox Content="{loc:Loc FieldAllowExtendedTime}" IsChecked="{Binding UserExtendStopTimer}" IsEnabled="{Binding !ImmediateStop}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldGraceTime}" Classes="field-label" />
                            <NumericUpDown Value="{Binding ExtendDelaySec}" Minimum="1" Maximum="3600" FormatString="0" IsEnabled="{Binding UserExtendStopTimer}" HorizontalAlignment="Left" Width="160" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Padding="0,0,10,24" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsUpdateSection}">
                    <StackPanel Spacing="14" Margin="0,0,0,28">
                        <TextBlock Text="{loc:Loc TabUpdate}" Classes="h2" />
                        <CheckBox Content="{loc:Loc FieldCheckUpdateAtStart}" IsChecked="{Binding CheckAtStart}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldUpdateDelay}" Classes="field-label" />
                            <ComboBox SelectedIndex="{Binding AutoCheckDelay}" IsEnabled="{Binding CheckAtStart}" HorizontalAlignment="Left" Width="200">
                                <ComboBoxItem Content="{loc:Loc UpdateIntervalDaily}" />
                                <ComboBoxItem Content="{loc:Loc UpdateIntervalWeekly}" />
                                <ComboBoxItem Content="{loc:Loc UpdateIntervalMonthly}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc FieldUpdateBranch}" Classes="field-label" />
                            <ComboBox SelectedIndex="{Binding Branch}" HorizontalAlignment="Left" Width="200">
                                <ComboBoxItem Content="Stable" />
                                <ComboBoxItem Content="Pre-release" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
